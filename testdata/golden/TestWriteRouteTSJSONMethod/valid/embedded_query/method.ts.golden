    list: (query: testEmbeddedQueryRequest): Promise<testEmbeddedQueryRequest> => {
      const search = new URLSearchParams();
      if (query["limit"] !== undefined && query["limit"] !== null) search.set("limit", String(query["limit"]));
      return request<testEmbeddedQueryRequest>("GET", "/items" + (search.size ? `?${search}` : ""));
    },
